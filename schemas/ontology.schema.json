{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SteveBehren/Andesite/schemas/ontology.schema.json",
  "title": "Andesite ontology overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["actorKinds", "actors", "mechanisms", "actions", "outcomes", "provisionRights", "provinces", "entries"],
  "properties": {
    "_comment": { "type": "string" },
    "actorKinds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/i18n" } },
    "actors": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "short", "name", "aliases"],
        "properties": {
          "kind": { "type": "string" },
          "short": { "type": "string", "minLength": 1 },
          "parent": { "type": "string" },
          "name": { "$ref": "#/$defs/i18n" },
          "note": { "$ref": "#/$defs/i18n" },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 2 } }
        }
      }
    },
    "mechanisms": { "type": "object", "additionalProperties": { "$ref": "#/$defs/i18n" } },
    "actions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["mechanism", "name"],
        "properties": { "mechanism": { "type": "string" }, "name": { "$ref": "#/$defs/i18n" } }
      }
    },
    "outcomes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z_]*$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["class", "name"],
        "properties": {
          "class": { "enum": ["remedy", "partial", "deflected", "adverse"] },
          "name": { "$ref": "#/$defs/i18n" }
        }
      }
    },
    "provisionRights": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
    },
    "provinces": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
    },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^AND-[0-9]{4,}$" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["actors", "actions", "outcomes"],
        "properties": {
          "actors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["type", "date"],
              "properties": {
                "type": { "type": "string" },
                "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object", "additionalProperties": false, "required": ["en", "id", "nl", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 },
        "nl": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 }
      }
    }
  }
}
